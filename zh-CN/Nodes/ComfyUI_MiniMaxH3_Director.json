    "MiniMaxH3DirectorRefine": {
        "title": "MiniMax H3 导演台精修",
        "description": "打包精修 / 放大配置，接入导演台的 refine 端口。refine = 同分辨率二次采样精修；upscale = 先放大到目标画布再二采；latent_upscale = 仅放大 H3 latent 不再二采。二采噪声表来自 BasicScheduler / ManualSigmas。",
        "inputs": {
            "refine_model": "二采模型（MODEL）",
            "sigmas": "二采噪声表（SIGMAS）",
            "upscale_model": "放大模型（UPSCALE_MODEL）"
