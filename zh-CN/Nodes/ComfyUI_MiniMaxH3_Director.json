            "lowres_scale": "低清画布倍率",
            "sampler_mode": "采样器模式",
            "native_low_carry": "原生低清尾传递",
            "bd_grp_selflift_lift": "分组：提升 / 3D",
            "latent_upscale_model": "3D Latent 放大权重",
            "latent_upsample": "升采样插值方式",
            "rho": "像素锚混合系数",
            "w_min": "像素锚最小权重",
            "w_max": "像素锚最大权重",
            "enable_latent_chunking": "3D 提升时间分块",
