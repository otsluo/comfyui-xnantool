    "MiniMaxH3DirectorSemanticBridge": {
        "title": "MiniMax H3 导演台语义桥",
        "description": "打包语义桥配置，接入导演台的 semantic_bridge 端口（位于 SelfLift 之上）。接线后用已发布的 student MLP 重写每段的官方条件 token（RMS 归一化 → 5120→512→512→5120 → 模长对齐 → 残差混合）。原版蒸馏于 FL2VA；r2v / v2v / rv2v 为强制兼容，谨慎使用。不接则完全不变。",
        "inputs": {},
        "widgets": {
            "adapter": "适配器权重",
            "alpha": "残差混合强度",
            "magnitude_match": "模长对齐"
        },
        "outputs": {
            "semantic_bridge": "语义桥配置"
        }
    },
