            "seed_mode": "种子模式",
            "aspect_ratio": "宽高比",
            "megapixels": "百万像素",
            "width": "宽度",
            "height": "高度",
            "skip_fl2v": "跳过首尾帧镜头",
            "confirm_first_pass": "先确认一采再二采",
            "enable_latent_chunking": "Latent 时间分块",
            "enable_tiling": "二采空间分块",
            "tile_count": "分块数量",
            "tile_overlap": "分块重叠",
