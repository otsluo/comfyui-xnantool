            "width": "目标宽度",
            "height": "目标高度"
        }
    },
    "MiniMaxH3DirectorSelfLift": {
        "title": "MiniMax H3 导演台 SelfLift",
        "description": "打包 SelfLift（渐进式一采）配置，接入导演台的 selflift 端口（位于精修之上）。接线后每段一采变为：低清前缀 + 3D 提升 + 高清收尾；不接则维持单阶段采样。段间连续性保留原生低清尾 + 高清钉帧。仅支持 Euler 采样器，不包含 TST。",
        "inputs": {
            "model_hires": "高清阶段模型（MODEL）"
        },
        "widgets": {
